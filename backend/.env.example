# 后端运行配置。复制为本地导出脚本或直接 export 这些变量。
# 本服务不读取 .env 文件（避免生产环境误加载），请用 shell 导出或容器注入。

# dev 或 prod。prod 会拒绝启动，除非补齐 JWT 鉴权与真实 CLAIM_PEPPER（见 README）
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# 声明码哈希的服务端密钥，至少 16 字节。生产必须换成随机值：
#   openssl rand -base64 32
CLAIM_PEPPER=dev-only-pepper-please-change-me

# MQTT（M1 接入 paho 后生效）
MQTT_URL=tcp://127.0.0.1:1883
MQTT_USER=
MQTT_PASSWORD=

# 仅开发：没有任何请求头时，把请求视为该用户已登录
DEV_USER_ID=11111111-1111-1111-1111-111111111111

# 仅开发：启动时注册演示设备 BKL-2026-000001，声明码如下（16 位 Base32）
# 可用它调 POST /v1/devices:bind 做冒烟测试
DEV_SEED_CLAIM=7QK2M5XJ4TZP6RWN
