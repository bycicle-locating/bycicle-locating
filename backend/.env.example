# 后端运行配置。Compose 会自动读取同目录的 .env；直接运行二进制时用 shell 导出。
# 服务本身不读取 .env（避免生产环境误加载），只认进程环境变量。

# dev 或 prod。prod 必须有 DATABASE_URL 与 JWT_SECRET，否则拒绝启动。
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# 为空且 dev → 内存 store；prod 必填。容器内主机名是 postgres，不是 127.0.0.1。
# 密码含特殊字符时先 URL-encode。
# DATABASE_URL=postgres://bkl:<url-encoded-password>@postgres:5432/bike_locating?sslmode=disable
DATABASE_URL=

# 必填且至少 32 字节；dev 留空会用开发默认值并告警。生成：
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h
JWT_ISSUER=bicycle-locating

# 仅 Docker 构建使用；服务器在中国大陆时可设为 https://goproxy.cn,direct
GOPROXY=

# 必填：声明码 HMAC 密钥，至少 16 字节。生成方式：
#   openssl rand -base64 32
CLAIM_PEPPER=

# 仅开发：没有 X-Dev-User 请求头时，把请求视为该用户已登录；留空则必须带请求头。
# 公网部署不要设置，否则无头请求也会被当成固定用户。
DEV_USER_ID=

# 仅开发：启动时注册演示设备 BKL-2026-000001，必须是 16 位 Base32（A-Z2-7）。
# 生成方式：openssl rand -base64 32 | tr -dc 'A-Z2-7' | head -c 16
DEV_SEED_CLAIM=

# MQTT（M1 接入 paho 后生效）
MQTT_URL=tcp://127.0.0.1:1883
MQTT_USER=
MQTT_PASSWORD=

# docker compose
BKL_HTTP_PORT=32525
# 默认只绑回环：公网入口是 Cloudflare Tunnel。确需直连时显式改成 0.0.0.0 并限制来源 IP。
BKL_BIND_ADDR=127.0.0.1
BKL_IMAGE_TAG=dev

# 启用 deps profile 前必填；默认 profile（nginx + backend）不需要。生成：
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# 公网联调实例已启用 Access；smoke/联调脚本需要服务令牌，本地/CI 不经过 Access 时留空。
# 服务令牌不要提交；只在服务器 .env 或调用方环境里设置。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# 仅 tunnel profile 使用：Cloudflare Zero Trust → Networks → Tunnels 创建的 token
TUNNEL_TOKEN=
