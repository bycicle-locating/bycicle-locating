#!/bin/sh
# 阻止直接推送到 main。
#
# 为什么需要它：本仓库当前是 GitHub Free + private，服务端分支保护不可用
# （见 CONTRIBUTING.md §1.1）。这个 hook 是本地唯一能"真正拦住"的一层。
#
# 安装（每个 clone 执行一次）：
#   git config core.hooksPath .githooks
#
# 确需直接推送（初始化、紧急修复）：
#   SKIP_MAIN_GUARD=1 git push
#
# 注意：hook 可被本地绕过（--no-verify / 直接改配置），因此它防的是"手滑与习惯"，
# 不是恶意。真正的强制需要服务端规则。

set -u

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" != "$protected" ]; then
        continue
    fi

    # 删除远端 main：任何情况下都拦
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        echo "pre-push: 拒绝删除远端 main 分支。" >&2
        exit 1
    fi

    if [ "${SKIP_MAIN_GUARD:-0}" = "1" ]; then
        echo "pre-push: SKIP_MAIN_GUARD=1，已跳过 main 保护（请确认这是有意为之）。" >&2
        continue
    fi

    cat >&2 <<'EOF'

✗ 拒绝直接推送到 main。

  正确做法：
    git switch -c feat/<范围>-<简述>
    git push -u origin feat/<范围>-<简述>
    gh pr create --fill        # 或到 GitHub 上开 PR

  确需直接推送（仅限初始化/紧急修复）：
    SKIP_MAIN_GUARD=1 git push

EOF
    exit 1
done

exit 0
