menu "自行车定位设备"

    config BKL_DEVICE_MODEL
        string "硬件型号"
        default "BKL1"
        help
            写入 device-info 与后端 devices.model，便于按型号区分固件行为。

    config BKL_MQTT_HOST
        string "MQTT broker 主机名"
        default "mqtt.example.com"
        help
            只填主机名，不要把协议和端口拼进来；端口单独配置以便统一改 TLS。

    config BKL_MQTT_PORT
        int "MQTT broker 端口"
        default 8883
        help
            生产必须 8883（TLS）。1883 只允许本地联调。

    config BKL_SAMPLE_INTERVAL_S
        int "骑行采样间隔（秒）"
        range 5 600
        default 10
        help
            骑行状态下的 GNSS 采样间隔。数值越小轨迹越细，功耗与流量越高。

    config BKL_UPLOAD_INTERVAL_S
        int "批量上报间隔（秒）"
        range 30 3600
        default 60
        help
            距上次成功上报超过该时长就尝试发一批。

    config BKL_IDLE_INTERVAL_S
        int "静止心跳间隔（秒）"
        range 60 3600
        default 1800
        help
            静止时每次唤醒联网上报的间隔。拉长这一项对续航影响最大。

    config BKL_SELFTEST_ON_BOOT
        bool "开机自检 ringbuf + 编码 + 发布"
        default n
        help
            用合成点跑一次 ringbuf → proto_encode → publish 全链路，
            结果只打日志、不产生真实上报。用于产线与硬件验证，正式固件请关闭。

    config BKL_AUDIO_LRCLK
        int "提示音 I²S LRCLK（WS）引脚"
        default 14
        help
            I²S 数字功放模块的 LRCLK/WS。实物接线见 docs/hardware.md §3.1/§3.2。
            注意 GPIO22–25 在 ESP32-S3 上不存在，别写进这里。

    config BKL_AUDIO_BCLK
        int "提示音 I²S BCLK（SCK）引脚"
        default 13
        help
            I²S 数字功放模块的 BCLK/SCK。

    config BKL_AUDIO_DIN
        int "提示音 I²S DIN（SD）引脚"
        default 12
        help
            ESP32 → 功放的数据线。功放的 WS/SCK/SD 焊盘属于录音方向，本固件不用。

    config BKL_AUDIO_SAMPLE_RATE_HZ
        int "提示音采样率（Hz）"
        range 8000 48000
        default 16000
        help
            16 kHz 足够放提示音；采样率越高底噪与功耗越大。

    config BKL_AUDIO_AMPLITUDE
        int "提示音峰值幅度（0–32767）"
        range 0 32767
        default 8000
        help
            相对满量程的峰值。默认约 -12 dBFS：户外能听清但不至于刺耳；
            装壳后按实测调，别一上来给 32767。

    config BKL_AUDIO_SELFTEST_ON_BOOT
        bool "开机播放一次找车提示音"
        default n
        help
            上电自检 I²S 通道与喇叭接线是否正常，仅用于产线与硬件验证，正式固件请关闭。

endmenu
